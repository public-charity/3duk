    "projects\\one\\Saved\\Phase1\\reuse_garrard_recovery42.py": "\"\"\"Reuse only byte-identical, previously reconstructed parent documents.\"\"\"\nimport json,os,sys\nfrom pathlib import Path\nROOT=Path(__file__).resolve().parents[2];REPO=ROOT.parents[1]\nsys.path.insert(0,str(ROOT/'Tools'))\nfrom phase1_qc import atomic_json,sha256\nbase=ROOT/'Saved/Phase1'\nmanifest_path=ROOT/'docs/checkpoints/phase1_42_geometry_selection.json'\nprevious_path=ROOT/'docs/checkpoints/phase1_40_geometry_selection.json'\nmanifest=json.loads(manifest_path.read_text(encoding='utf-8'))\nprevious=json.loads(previous_path.read_text(encoding='utf-8'))\nroot=base/'restored_geometry_selection'/sha256(manifest_path)[:20]\nparent=base/'restored_geometry_selection'/sha256(previous_path)[:20]\nstate=json.loads((root/'state.json').read_text(encoding='utf-8'))\nold=json.loads((parent/'state.json').read_text(encoding='utf-8'))\nassert old['status']=='complete' and old['completed']==246\nassert state['completed']==64 and 'site_x12_y13.json' in state['documents']\nfresh=sorted(state['documents']);reused=[]\nfor name,expected in manifest['document_sha256'].items():\n    if name in state['documents']:\n        assert sha256(root/name)==expected;continue\n    assert previous['document_sha256'][name]==expected\n    assert old['documents'][name]['sha256']==expected and sha256(parent/name)==expected\n    target=root/name;temporary=target.with_suffix('.pending')\n    with temporary.open('wb') as handle:\n        handle.write((parent/name).read_bytes());handle.flush();os.fsync(handle.fileno())\n    os.replace(temporary,target);assert sha256(target)==expected;reused.append(name)\nreport=dict(status='seeded_exact_parent_recovery',phase1_accepted=False,freshly_reconstructed=fresh,\n    reused_previous_exact_reconstruction=reused,fresh_count=len(fresh),reused_count=len(reused),\n    parent_manifest_sha256=sha256(previous_path),manifest_sha256=sha256(manifest_path),\n    note='Resume the standard restorer to reconcile seeded documents and complete state. No geometry proof inferred from recovery.',\n    input_sha256={str(path):sha256(path) for path in (Path(__file__),manifest_path,previous_path,parent/'state.json')})\natomic_json(root/'recovery_reuse.json',report);print(json.dumps(dict(root=str(root),fresh=len(fresh),reused=len(reused))))\n",
