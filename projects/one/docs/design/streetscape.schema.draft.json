        "osm_id": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
        "name": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
        "cls": { "oneOf": [ { "type": "string" }, { "type": "null" } ], "description": "OSM highway / railway / barrier value." },
        "tags": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Selected OSM tags passed through (sidewalk, lanes, surface, ...)." },
        "tile": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" }, "description": "[i, j] of the pipeline tile the way was read from." }
      }
    },

    "Overlay": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["kind", "pts"],
      "properties": {
        "kind": { "type": "string", "enum": ["osm_way", "step06_smoothed", "other"] },
        "pts": { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" } }, "description": "[x, y] or [x, y, z] in the file frame. The RAW OSM vertices when kind is osm_way." },
        "osm_id": { "oneOf": [ { "type": "string" }, { "type": "null" } ] }
      }
    },

    "ProfileIds": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "properties": {
        "road": { "oneOf": [ { "$ref": "#/$defs/Id" }, { "type": "null" } ], "description": "null = no carriageway (barrier-only / hedge-only spline; width 0)." },
        "edge_left": { "oneOf": [ { "$ref": "#/$defs/Id" }, { "type": "null" } ] },
        "edge_right": { "oneOf": [ { "$ref": "#/$defs/Id" }, { "type": "null" } ] },
        "hedge_left": { "oneOf": [ { "$ref": "#/$defs/Id" }, { "type": "null" } ] },
        "hedge_right": { "oneOf": [ { "$ref": "#/$defs/Id" }, { "type": "null" } ] }
      }
    },

    "Spline": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["id", "source", "profile_ids", "points"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "source": { "$ref": "#/$defs/Source" },
        "profile_ids": { "$ref": "#/$defs/ProfileIds" },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/Point" } },
        "sampling": { "$ref": "#/$defs/Sampling" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/Segment" }, "default": [] },
        "drop_kerbs": { "type": "array", "items": { "$ref": "#/$defs/SplineDropKerb" }, "default": [] },
        "overlay": { "$ref": "#/$defs/Overlay" },
        "junction_start": { "oneOf": [ { "$ref": "#/$defs/Id" }, { "type": "null" } ], "description": "Placeholder: junction id at points[0]." },
        "junction_end": { "oneOf": [ { "$ref": "#/$defs/Id" }, { "type": "null" } ], "description": "Placeholder: junction id at points[-1]." }
      }
    },

    "Junction": {
      "description": "Placeholder for a later round. Renderers ignore it now; spline ends are not trimmed. Step 06 '_junction' discs map onto kind 'disc'.",
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["id", "x", "y", "ends"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "x": { "type": "number" }, "y": { "type": "number" },
        "z": { "oneOf": [ { "type": "number" }, { "type": "null" } ] },
        "radius_m": { "$ref": "#/$defs/NonNeg" },
        "kind": { "type": "string", "enum": ["disc", "none"], "default": "disc" },
        "ends": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["spline_id", "end"],
            "properties": { "spline_id": { "$ref": "#/$defs/Id" }, "end": { "type": "string", "enum": ["start", "end"] } }
          }
        }
      }
    }
  },

