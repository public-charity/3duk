{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/public-charity/3duk/projects/one/schema/streetscape.schema.json",
  "title": "Streetscape interchange format (draft for design review)",
  "description": "One file = one site (or one test stretch). Frame: local metres from origin {E,N}, right-handed, X east, Y north, Z up (ODN metres, not re-based). Every distance in metres; every 's' is arc length from the spline's first point along the RESAMPLED centreline. Left/right are relative to the direction of travel (increasing s); positive lateral offset d is LEFT. Keys beginning with '_' are free-form notes anywhere. Draft 1.0.0 -- promoted to projects/one/schema/streetscape.schema.json when implementation starts.",
  "type": "object",
  "required": ["schema_version", "site", "crs", "origin", "vertical_datum", "frame", "generator", "profiles", "splines"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$", "description": "Semver of this schema. Readers accept any 1.x; unknown optional fields are ignored, unknown required fields are an error." },
    "site": { "type": "string", "minLength": 1, "description": "Site name as in sources/config/sites/<site>.json, e.g. 'thanet' or 'margate'." },
    "crs": { "type": "string", "pattern": "^EPSG:[0-9]+$", "description": "CRS of origin.E/N. Always EPSG:27700 for this project." },
    "origin": {
      "type": "object", "required": ["E", "N"], "additionalProperties": false,
      "properties": { "E": { "type": "number" }, "N": { "type": "number" } },
      "description": "Site grid origin in CRS metres. local_x = E - origin.E, local_y = N - origin.N."
    },
    "vertical_datum": { "type": "string", "description": "Datum of every z. 'ODN' for EA LIDAR." },
    "frame": { "const": "local-metres, X east, Y north, Z up", "description": "Fixed string; a reader must refuse any other value." },
    "generator": { "type": "string", "description": "Who wrote the file, e.g. 'sources/adapters/unreal.py@<git sha>' or 'hand-authored'." },
    "materials": {
      "type": "object", "additionalProperties": { "$ref": "#/$defs/MaterialHint" }, "patternProperties": { "^_": {} },
      "description": "Optional preview hints per material name. Geometry refers to materials by name only; engines map names to real materials."
    },
    "profiles": {
      "type": "object", "required": ["road", "edge", "hedge"], "additionalProperties": false, "patternProperties": { "^_": {} },
      "properties": {
        "road":  { "type": "object", "additionalProperties": { "$ref": "#/$defs/RoadProfile" },  "patternProperties": { "^_": {} } },
        "edge":  { "type": "object", "additionalProperties": { "$ref": "#/$defs/EdgeProfile" },  "patternProperties": { "^_": {} } },
        "hedge": { "type": "object", "additionalProperties": { "$ref": "#/$defs/HedgeProfile" }, "patternProperties": { "^_": {} } }
      }
    },
    "splines": { "type": "array", "items": { "$ref": "#/$defs/Spline" } },
    "junctions": { "type": "array", "items": { "$ref": "#/$defs/Junction" }, "default": [] }
  },

  "$defs": {
    "Id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "minLength": 1 },
    "NonNeg": { "type": "number", "minimum": 0 },
    "Pos": { "type": "number", "exclusiveMinimum": 0 },
    "SideOrBoth": { "type": "string", "enum": ["left", "right", "both"] },
    "SEnd": { "description": "Arc length in metres; null means 'to the end of the spline'.", "oneOf": [ { "type": "number", "minimum": 0 }, { "type": "null" } ] },
    "MaterialName": { "type": "string", "minLength": 1, "description": "Material name. Geometry carries names; engines map them." },

    "MaterialHint": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "properties": {
        "base_color": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "two_sided": { "type": "boolean", "default": false },
        "texture_repeat_m": { "$ref": "#/$defs/Pos", "description": "World size of one texture tile; UVs are in metres so the engine divides by this." }
      }
    },

    "Sampling": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "description": "All optional. Precedence: spline.sampling > road profile sampling_defaults > built-in defaults (road: step 2.0, min 0.25, gain 20, window 20, passes 1; rail: step 1.0, min 0.25, gain 60, window 40, passes 2).",
      "properties": {
        "step_m": { "$ref": "#/$defs/Pos", "description": "Sample spacing on straights. step(k) = clamp(step_m / (1 + curvature_gain*|k|), min_step_m, step_m)." },
        "min_step_m": { "$ref": "#/$defs/Pos" },
        "curvature_gain": { "$ref": "#/$defs/NonNeg", "description": "Metres. Multiplies curvature (1/m) in the step formula." },
        "smoothing_window_m": { "$ref": "#/$defs/NonNeg", "description": "Full width W of the centred arc-length moving average applied to terrain heights and bank." },
        "smoothing_passes": { "type": "integer", "minimum": 0, "maximum": 4 },
        "width_ramp_m": { "$ref": "#/$defs/Pos", "description": "Default ramp length for segment overrides that do not set ramp_m." },
        "bank_max_deg": { "type": "number", "minimum": 0, "maximum": 30, "description": "Clamp on terrain-derived bank." },
        "bank_probe_min_half_width_m": { "$ref": "#/$defs/Pos", "description": "Cross-slope is probed at +-max(width/2, this)." },
        "pin_blend_m": { "$ref": "#/$defs/Pos", "description": "Linear blend distance either side of a pinned point z." },
        "extra_stations_m": { "type": "array", "items": { "$ref": "#/$defs/NonNeg" }, "description": "Additional mandatory sample stations (tests, authoring)." }
      }
    },

    "Camber": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["parabolic", "planar", "none"] },
        "crossfall_pct": { "type": "number", "minimum": 0, "maximum": 10, "description": "Edge slope in percent. parabolic: crown = crossfall/100 * width/4; planar: two planes at this slope." },
        "camber_m": { "$ref": "#/$defs/NonNeg", "description": "Explicit crown height; overrides crossfall_pct when present." }
      }
    },

    "Marking": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["offset_m", "width_m", "pattern", "material"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "anchor": { "type": "string", "enum": ["centre", "edge_left", "edge_right"], "default": "centre",
                    "description": "centre: offset_m is signed, + = left of travel. edge_left/edge_right: offset_m >= 0 measured INWARD from that road edge, so the line follows width changes (yellow lines hug the kerb)." },
        "offset_m": { "type": "number", "description": "Lateral position of the strip centre (for double: of the pair centre)." },
        "width_m": { "$ref": "#/$defs/Pos", "description": "Width of ONE line (each line of a double)." },
        "pattern": { "type": "string", "enum": ["solid", "dashed", "double", "none"] },
        "dash_m": { "$ref": "#/$defs/Pos", "description": "Mark length for dashed." },
        "gap_m": { "$ref": "#/$defs/Pos", "description": "Gap length for dashed." },
        "phase_m": { "type": "number", "default": 0, "description": "Dash k covers s in [phase + k*(dash+gap), phase + k*(dash+gap) + dash]. Global along the spline, so dashes are continuous across segment boundaries." },
        "double_gap_m": { "$ref": "#/$defs/Pos", "description": "Clear gap between the two lines of a double." },
        "material": { "$ref": "#/$defs/MaterialName" },
        "lift_m": { "type": "number", "minimum": 0, "maximum": 0.02, "default": 0.003, "description": "Strip sits this far above the carriageway (real thermoplastic is 1.5-3 mm)." },
        "s0_m": { "$ref": "#/$defs/NonNeg", "description": "Optional s-range; omitted = whole spline." },
        "s1_m": { "$ref": "#/$defs/SEnd" }
      },
      "allOf": [
        { "if": { "properties": { "pattern": { "const": "dashed" } } }, "then": { "required": ["dash_m", "gap_m"] } },
        { "if": { "properties": { "pattern": { "const": "double" } } }, "then": { "required": ["double_gap_m"] } }
      ]
    },

    "RailSpec": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["gauge_m", "rail", "sleeper", "ballast"],
      "properties": {
        "gauge_m": { "$ref": "#/$defs/Pos", "description": "Distance between the INNER faces of the rail heads (1.435 standard). Rail centrelines sit at +-(gauge/2 + head_width/2)." },
        "pad_m": { "$ref": "#/$defs/NonNeg", "default": 0.005, "description": "Rail foot sits this far above the sleeper top." },
        "rail": {
          "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
          "required": ["height_m", "head_width_m", "foot_width_m", "web_thickness_m", "head_depth_m", "foot_thickness_m", "material"],
          "properties": {
            "profile_id": { "type": "string", "description": "Informational name of the section, e.g. 'BS113A'." },
            "height_m": { "$ref": "#/$defs/Pos" }, "head_width_m": { "$ref": "#/$defs/Pos" }, "foot_width_m": { "$ref": "#/$defs/Pos" },
            "web_thickness_m": { "$ref": "#/$defs/Pos" }, "head_depth_m": { "$ref": "#/$defs/Pos" }, "foot_thickness_m": { "$ref": "#/$defs/Pos" },
            "material": { "$ref": "#/$defs/MaterialName" }
          }
        },
        "sleeper": {
          "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
          "required": ["length_m", "width_m", "height_m", "pitch_m", "material"],
          "properties": {
            "length_m": { "$ref": "#/$defs/Pos" }, "width_m": { "$ref": "#/$defs/Pos" }, "height_m": { "$ref": "#/$defs/Pos" },
            "pitch_m": { "$ref": "#/$defs/Pos" }, "phase_m": { "type": "number", "default": 0 },
            "embed_m": { "$ref": "#/$defs/NonNeg", "default": 0.10, "description": "How far the sleeper sits below the ballast top surface." },
            "mode": { "type": "string", "enum": ["instances", "merged"], "default": "instances" },
            "material": { "$ref": "#/$defs/MaterialName" }
          }
        },
        "ballast": {
          "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
          "required": ["top_width_m", "shoulder_slope", "depth_m", "material"],
          "properties": {
            "top_width_m": { "$ref": "#/$defs/Pos", "description": "Flat top of the ballast bed (sleeper length + 2 shoulders)." },
            "shoulder_slope": { "$ref": "#/$defs/Pos", "description": "Horizontal run per 1 m of fall (1.5 = 1 in 1.5)." },
            "depth_m": { "$ref": "#/$defs/Pos", "description": "Ballast top to formation (toe of the shoulder)." },
            "material": { "$ref": "#/$defs/MaterialName" }
          }
        }
      }
    },

    "RoadProfile": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["kind", "width_m", "surface_material", "camber", "markings"],
      "properties": {
        "kind": { "type": "string", "enum": ["road", "rail"], "description": "rail: the ribbon is the ballast bed; 'rail' block required; sampling_defaults tighter." },
        "lanes": { "type": "integer", "minimum": 0 },
        "lane_widths_m": { "type": "array", "items": { "$ref": "#/$defs/Pos" }, "description": "Informational; width_m is authoritative for geometry. Validation warns if the sum exceeds width_m." },
        "width_m": { "$ref": "#/$defs/NonNeg", "description": "Total carriageway width (rail: ballast top width). Base of the width function w(s); points and segments override it." },
        "surface_material": { "$ref": "#/$defs/MaterialName" },
        "camber": { "$ref": "#/$defs/Camber" },
        "overlap_m": { "type": "number", "minimum": 0.03, "maximum": 0.10, "default": 0.04, "description": "How far the road skirt extends past the kerb line (seam rule: road owns the seam). Hard floor 0.03." },
        "skirt_drop_m": { "type": "number", "minimum": 0, "maximum": 0.03, "default": 0.02, "description": "The skirt strip drops this much over overlap_m so it hides inside the kerb block." },
        "lateral_station_spacing_m": { "$ref": "#/$defs/Pos", "default": 1.0, "description": "Max spacing of the ribbon's lateral vertex rows (n_interior = max(7, 2*ceil(w_max/(2*this)) + 1))." },
        "markings": { "type": "array", "items": { "$ref": "#/$defs/Marking" } },
        "rail": { "$ref": "#/$defs/RailSpec" },
        "sampling_defaults": { "$ref": "#/$defs/Sampling" }
      },
      "allOf": [ { "if": { "properties": { "kind": { "const": "rail" } } }, "then": { "required": ["rail"] } } ]
    },

    "Lip": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["radius", "chamfer", "none"] },
        "size_m": { "$ref": "#/$defs/NonNeg", "default": 0.02, "description": "Radius, or chamfer leg. Scales with the drop-kerb height factor." },
        "arc_points": { "type": "integer", "minimum": 1, "maximum": 8, "default": 3 }
      }
    },

    "SplitMaterial": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "inner": { "$ref": "#/$defs/MaterialName", "description": "Carriageway side: kerb face + top up to the boundary." },
        "outer": { "$ref": "#/$defs/MaterialName", "description": "Pavement side: top beyond the boundary, pavement top, back face." },
        "boundary_frac": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5, "description": "Position of the boundary across the kerb top, 0 = lip, 1 = back edge. The top stays flush: both materials share the same vertices and height." }
      },
      "allOf": [ { "if": { "properties": { "enabled": { "const": true } } }, "then": { "required": ["inner", "outer"] } } ]
    },

    "DropKerb": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["s_m"],
      "properties": {
        "s_m": { "$ref": "#/$defs/NonNeg", "description": "Start of the FLAT run. The down-ramp occupies [s_m - ramp_m, s_m], the up-ramp [s_m + length_m, s_m + length_m + ramp_m]." },
        "length_m": { "$ref": "#/$defs/NonNeg", "default": 1.83, "description": "Flat run (two 915 mm kerb units)." },
        "ramp_m": { "$ref": "#/$defs/Pos", "default": 0.915, "description": "One dropper kerb unit." },
        "target_height_m": { "type": "number", "minimum": 0, "maximum": 0.2, "default": 0.006, "description": "Upstand in the flat run. 6 mm = flush pedestrian dropped kerb; 0.025 for a vehicle crossing." }
      }
    },

    "Barrier": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["s0_m", "s1_m", "type"],
      "properties": {
        "s0_m": { "$ref": "#/$defs/NonNeg" },
        "s1_m": { "$ref": "#/$defs/SEnd" },
        "type": { "type": "string", "enum": ["brick_wall", "stone_wall", "retaining_wall", "chain_link", "railing", "none"] },
        "height_m": { "$ref": "#/$defs/Pos", "description": "Top of the barrier above the pavement back edge (or kerb top / road edge when there is no pavement / no kerb)." },
        "thickness_m": { "$ref": "#/$defs/Pos" },
        "material": { "$ref": "#/$defs/MaterialName" },
        "coping_material": { "$ref": "#/$defs/MaterialName", "default": "coping_concrete" },
        "coping_overhang_m": { "$ref": "#/$defs/NonNeg", "default": 0.025 },
        "coping_height_m": { "$ref": "#/$defs/NonNeg", "default": 0.05 },
        "post_pitch_m": { "$ref": "#/$defs/Pos", "description": "chain_link / railing: post spacing along s, posts at s0 and every pitch, last one at s1." },
        "post_size_m": { "$ref": "#/$defs/Pos", "default": 0.06, "description": "Post diameter (chain_link) or square side (railing)." },
        "rails_m": { "type": "array", "items": { "$ref": "#/$defs/NonNeg" }, "description": "railing: heights of the horizontal rails. Default [height-0.02, 0.5*height, 0.10]." },
        "rail_size_m": { "$ref": "#/$defs/Pos", "default": 0.04 },
        "offset_m": { "type": "number", "default": 0, "description": "Inner face of the barrier from the pavement back edge, outward positive." },
        "skirt_m": { "$ref": "#/$defs/NonNeg", "default": 0.30, "description": "Walls extend this far below their base so they meet the ground." }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["brick_wall", "stone_wall", "retaining_wall", "chain_link", "railing"] } } }, "then": { "required": ["height_m", "thickness_m", "material"] } },
        { "if": { "properties": { "type": { "enum": ["chain_link", "railing"] } } }, "then": { "required": ["post_pitch_m"] } }
      ]
    },

    "Embankment": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["s0_m", "s1_m", "side", "kind", "material"],
      "properties": {
        "s0_m": { "$ref": "#/$defs/NonNeg" },
        "s1_m": { "$ref": "#/$defs/SEnd" },
        "side": { "type": "string", "enum": ["left", "right", "both", "downhill", "uphill", "auto"], "description": "downhill = the side where the ground is below the road (fill), uphill = above (cut), auto = both, gated by threshold_m." },
        "kind": { "type": "string", "enum": ["batter", "retaining_wall", "auto"], "description": "auto: batter where the road is above ground, retaining_wall where it is below." },
        "slope_ratio": { "$ref": "#/$defs/Pos", "default": 1.5, "description": "Batter: horizontal run per 1 m of fall." },
        "wall_thickness_m": { "$ref": "#/$defs/Pos", "default": 0.30 },
        "wall_coping_m": { "$ref": "#/$defs/NonNeg", "default": 0.10, "description": "Retaining wall top above the ground it retains." },
        "threshold_m": { "$ref": "#/$defs/NonNeg", "default": 0.35, "description": "|z_back_edge - z_terrain| must exceed this for the entry to emit geometry at a sample." },
        "toe_extra_m": { "$ref": "#/$defs/NonNeg", "default": 0.30, "description": "Batter is extended this far below the terrain intersection." },
        "material": { "$ref": "#/$defs/MaterialName" }
      }
    },

    "EdgeProfile": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["kerb_width_m", "kerb_height_m", "pavement_width_m", "materials"],
      "properties": {
        "kerb_width_m": { "$ref": "#/$defs/NonNeg", "description": "0 = no kerb block (barrier-only or pavement-only edge)." },
        "kerb_height_m": { "$ref": "#/$defs/NonNeg", "description": "Upstand above the road edge." },
        "lip": { "$ref": "#/$defs/Lip", "default": { "kind": "radius", "size_m": 0.02, "arc_points": 3 } },
        "pavement_width_m": { "$ref": "#/$defs/NonNeg", "description": "0 = no pavement." },
        "pavement_crossfall_pct": { "type": "number", "minimum": 0, "maximum": 10, "default": 2.5, "description": "Pavement rises away from the kerb at this slope (drains to the channel)." },
        "pavement_max_crossfall_pct": { "type": "number", "minimum": 0, "maximum": 20, "default": 8.0, "description": "At drop kerbs the back edge is lowered only as far as needed to keep the crossfall under this." },
        "tuck_depth_m": { "$ref": "#/$defs/NonNeg", "default": 0.03, "description": "Kerb block starts this far below the road edge (under the road skirt)." },
        "tuck_in_m": { "$ref": "#/$defs/NonNeg", "default": 0.02, "description": "Kerb block underside extends this far toward the carriageway under the road." },
        "skirt_m": { "$ref": "#/$defs/NonNeg", "default": 0.30, "description": "Back face extends this far below the road edge to meet the ground." },
        "materials": {
          "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} }, "required": ["kerb", "pavement"],
          "properties": { "kerb": { "$ref": "#/$defs/MaterialName" }, "pavement": { "$ref": "#/$defs/MaterialName" } }
        },
        "split_material": { "$ref": "#/$defs/SplitMaterial", "default": { "enabled": false } },
        "drop_kerbs": { "type": "array", "items": { "$ref": "#/$defs/DropKerb" }, "default": [] },
        "barriers": { "type": "array", "items": { "$ref": "#/$defs/Barrier" }, "default": [] },
        "embankments": { "type": "array", "items": { "$ref": "#/$defs/Embankment" }, "default": [] }
      }
    },

    "Foliage": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["none", "cards", "instances"] },
        "density_per_m2": { "$ref": "#/$defs/NonNeg", "default": 12 },
        "card_size_m": { "$ref": "#/$defs/Pos", "default": 0.25 },
        "material": { "$ref": "#/$defs/MaterialName" },
        "mesh_id": { "type": "string", "description": "instances mode: engine-side mesh key." },
        "seed": { "type": "integer", "minimum": 0, "default": 1 }
      }
    },

    "HedgeSegment": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["s0_m", "s1_m"],
      "properties": {
        "s0_m": { "$ref": "#/$defs/NonNeg" },
        "s1_m": { "$ref": "#/$defs/SEnd" },
        "offset_m": { "type": "number", "default": 0.1, "description": "Gap between the barrier line (outer face of the barrier if one is present in this s-range, else the pavement back edge) and the hedge's inner face." },
        "height_override_m": { "$ref": "#/$defs/Pos" },
        "width_override_m": { "$ref": "#/$defs/Pos" }
      }
    },

    "HedgeProfile": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["width_m", "height_m", "top_profile", "material", "foliage", "segments"],
      "properties": {
        "width_m": { "$ref": "#/$defs/Pos" },
        "height_m": { "$ref": "#/$defs/Pos" },
        "top_profile": { "type": "string", "enum": ["flat", "rounded", "domed"] },
        "corner_radius_m": { "$ref": "#/$defs/NonNeg", "default": 0.15 },
        "corner_points": { "type": "integer", "minimum": 1, "maximum": 8, "default": 4 },
        "noise_amplitude_m": { "$ref": "#/$defs/NonNeg", "default": 0.06 },
        "noise_scale_m": { "$ref": "#/$defs/Pos", "default": 0.6 },
        "noise_seed": { "type": "integer", "minimum": 0, "default": 1 },
        "base_sink_m": { "$ref": "#/$defs/NonNeg", "default": 0.10, "description": "Volume extends this far below the pavement back-edge level." },
        "material": { "$ref": "#/$defs/MaterialName" },
        "foliage": { "$ref": "#/$defs/Foliage" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/HedgeSegment" } }
      }
    },

    "Point": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "z": { "oneOf": [ { "type": "number" }, { "type": "null" } ], "description": "Pin: forces the smoothed height here (blended over pin_blend_m). Omit/null = height from terrain." },
        "roll_deg": { "type": "number", "minimum": -30, "maximum": 30, "description": "Bank override at this point, + = left side up. Interpolated between points that set it; blended with terrain bank via a mask." },
        "width_m": { "$ref": "#/$defs/NonNeg", "description": "Width knot. Every point is a knot: value = width_m if given else the road profile's width_m; w(s) is piecewise linear in s." },
        "tags": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },

    "SegmentRoad": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "properties": {
        "width_m": { "$ref": "#/$defs/NonNeg" },
        "profile_id": { "$ref": "#/$defs/Id" },
        "edge_extra_left_m": { "type": "number", "default": 0, "description": "Added to edge_offset on the left (parking bay, verge strip)." },
        "edge_extra_right_m": { "type": "number", "default": 0 },
        "markings": { "type": "array", "items": { "$ref": "#/$defs/Marking" }, "description": "REPLACES the profile's marking list inside [s0,s1] (ranges of these markings are clipped to the segment)." },
        "markings_add": { "type": "array", "items": { "$ref": "#/$defs/Marking" }, "description": "APPENDS to whatever list is in force inside [s0,s1]." }
      }
    },

    "SegmentEdge": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "properties": {
        "profile_id": { "$ref": "#/$defs/Id" },
        "kerb_width_m": { "$ref": "#/$defs/NonNeg" },
        "kerb_height_m": { "$ref": "#/$defs/NonNeg" },
        "pavement_width_m": { "$ref": "#/$defs/NonNeg" },
        "pavement_crossfall_pct": { "type": "number", "minimum": 0, "maximum": 10 },
        "split_material": { "$ref": "#/$defs/SplitMaterial" },
        "barrier": { "oneOf": [ { "$ref": "#/$defs/BarrierInline" }, { "type": "null" } ], "description": "Barrier for exactly this s-range (null = explicitly none, overriding the profile's list here)." },
        "embankment": { "oneOf": [ { "$ref": "#/$defs/EmbankmentInline" }, { "type": "null" } ] }
      }
    },

    "BarrierInline": {
      "description": "A Barrier without s0_m/s1_m (they come from the enclosing segment).",
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["brick_wall", "stone_wall", "retaining_wall", "chain_link", "railing", "none"] },
        "height_m": { "$ref": "#/$defs/Pos" }, "thickness_m": { "$ref": "#/$defs/Pos" }, "material": { "$ref": "#/$defs/MaterialName" },
        "coping_material": { "$ref": "#/$defs/MaterialName" }, "coping_overhang_m": { "$ref": "#/$defs/NonNeg" }, "coping_height_m": { "$ref": "#/$defs/NonNeg" },
        "post_pitch_m": { "$ref": "#/$defs/Pos" }, "post_size_m": { "$ref": "#/$defs/Pos" },
        "rails_m": { "type": "array", "items": { "$ref": "#/$defs/NonNeg" } }, "rail_size_m": { "$ref": "#/$defs/Pos" },
        "offset_m": { "type": "number" }, "skirt_m": { "$ref": "#/$defs/NonNeg" }
      }
    },

    "EmbankmentInline": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["side", "kind", "material"],
      "properties": {
        "side": { "type": "string", "enum": ["left", "right", "both", "downhill", "uphill", "auto"] },
        "kind": { "type": "string", "enum": ["batter", "retaining_wall", "auto"] },
        "slope_ratio": { "$ref": "#/$defs/Pos" }, "wall_thickness_m": { "$ref": "#/$defs/Pos" }, "wall_coping_m": { "$ref": "#/$defs/NonNeg" },
        "threshold_m": { "$ref": "#/$defs/NonNeg" }, "toe_extra_m": { "$ref": "#/$defs/NonNeg" },
        "material": { "$ref": "#/$defs/MaterialName" }
      }
    },

    "SegmentHedge": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["present"],
      "properties": {
        "present": { "type": "boolean", "description": "false = no hedge in this range even if the profile's segments cover it." },
        "profile_id": { "$ref": "#/$defs/Id" },
        "offset_m": { "type": "number" },
        "height_m": { "$ref": "#/$defs/Pos" },
        "width_m": { "$ref": "#/$defs/Pos" }
      }
    },

    "Segment": {
      "description": "Per-spline override over an s-range. Later entries win where ranges overlap. Scalars ramp linearly over ramp_m either side of the range; lists (barrier, embankment, hedge, markings) switch exactly at s0/s1, which are mandatory sample stations.",
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
      "required": ["s0_m", "s1_m", "side"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "s0_m": { "$ref": "#/$defs/NonNeg" },
        "s1_m": { "$ref": "#/$defs/SEnd" },
        "side": { "type": "string", "enum": ["left", "right", "both", "centre"], "description": "centre: only the 'road' block is read. left/right/both: 'edge' and 'hedge' blocks apply to those sides; 'road' is also read (it is side-less)." },
        "ramp_m": { "$ref": "#/$defs/NonNeg", "description": "Default sampling.width_ramp_m (5.0)." },
        "road": { "$ref": "#/$defs/SegmentRoad" },
        "edge": { "$ref": "#/$defs/SegmentEdge" },
        "hedge": { "$ref": "#/$defs/SegmentHedge" }
      }
    },

    "SplineDropKerb": {
      "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} },
