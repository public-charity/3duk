# Text sources are always LF in the repo AND on checkout. A CRLF shebang line is
# "bad interpreter" on the linux/mac machines this pipeline actually runs on, and
# that must not depend on whichever core.autocrlf a contributor happens to have.
*.sh    text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
# Unreal / project sources added with projects/one. Same rule, same reason: one line ending in the
# repo and on checkout, whatever a contributor's core.autocrlf says.
*.cpp   text eol=lf
*.h     text eol=lf
*.cs    text eol=lf
*.ini   text eol=lf
*.ps1   text eol=lf
*.uproject text eol=lf
*.uplugin  text eol=lf
*.txt   text eol=lf
projects/one/docs/checkpoints/*.patch text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Binary art goes through LFS
*.psd  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text

# Blender prototype exports (Tools/blender/renders) -- geometry is binary
*.glb  filter=lfs diff=lfs merge=lfs -text

# Compressed recovery snapshots; do not store generated raster/package data in normal Git.
backups/*.zip filter=lfs diff=lfs merge=lfs -text
